{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoForge",
  "version": "0.1.0",
  "identifier": "com.autoforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoForge",
        "width": 1340,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AutoForge",
    "category": "DeveloperTool",
    "shortDescription": "Human-Lite-in-the-Loop software factory",
    "longDescription": "AutoForge orchestrates AI agents, code reviews, and project workflows into a self-driving software factory."
  }
}
